# Backend configuration. Copy to backend/.env and fill in. Never commit .env files.
# Optional overrides per environment: .env.development, .env.production (loaded after .env).

# --- Application ---------------------------------------------------------------
APP_ENV=development                 # development | test | production
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_DIR=logs
LOG_TO_FILE=true

# --- Data stores (match infra/docker-compose.yml) -------------------------------
DATABASE_URL=postgresql+asyncpg://movie:movie@localhost:5432/movie_companion
REDIS_URL=redis://localhost:6379/0

# --- Security ------------------------------------------------------------------
# Bearer token for the single-owner API. Required in production (32+ characters).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
OWNER_API_TOKEN=

# --- Browser worker (home machine only) -----------------------------------------
BROWSER_MODE=persistent             # persistent | cdp
BROWSER_CHANNEL=chrome              # chrome (installed Google Chrome) | chromium (Playwright build)
# Default: ~/.movie-companion/chrome-profile (outside the repo, mode 700). Never inside the repo.
# BROWSER_PROFILE_DIR=
BROWSER_CDP_URL=http://127.0.0.1:9222
BROWSER_HEADLESS=false
BROWSER_MAX_PAGE_LOADS_PER_HOUR=60

# --- Integrations (needed from later milestones) --------------------------------
TMDB_API_KEY=
OMDB_API_KEY=
GOOGLE_MAPS_API_KEY=
YOUTUBE_API_KEY=
LLM_PROVIDER=none                   # anthropic | openai | gemini | none
LLM_API_KEY=
LLM_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
